# ==============================

# Node.js Project .gitignore

# ==============================

# 🔹 Dependencies

node_modules/
jspm_packages/

# 🔹 Environment variables (IMPORTANT 🔐)

.env
.env.*
!.env.example

# 🔹 Logs

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 🔹 Runtime data

pids/
*.pid
*.seed
*.pid.lock

# 🔹 Coverage (testing)

coverage/
.nyc_output/

# 🔹 Build / Production

dist/
build/
out/

# 🔹 Cache

.cache/
.parcel-cache/
.next/
.nuxt/

# 🔹 Temporary files

tmp/
temp/

# 🔹 OS files

.DS_Store
Thumbs.db

# 🔹 IDE / Editor files

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# 🔹 ESLint cache

.eslintcache

# 🔹 Optional npm cache

.npm/

# 🔹 Uploads (if using file upload like multer)

uploads/
public/uploads/

# 🔹 Docker (optional)

docker-compose.override.yml

# 🔹 Misc

*.tgz
*.bak
*.swp
